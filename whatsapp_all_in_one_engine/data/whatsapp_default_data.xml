<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Template 1: Sales Order Confirmation -->
        <record id="whatsapp_template_sales_order" model="whatsapp.template">
            <field name="name">Sales Order Confirmation</field>
            <field name="template_name">sales_order_confirm</field>
            <field name="language_code">en_US</field>
            <field name="category">UTILITY</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="header_type">document</field>
            <field name="report_id" ref="sale.action_report_saleorder"/>
            <field name="body_text">Hello {{1}}, your Order {{2}} has been confirmed with total amount of {{3}}. Please find your official order confirmation PDF attached. Thank you for doing business with us!</field>
        </record>

        <record id="var_so_customer" model="whatsapp.template.variable">
            <field name="template_id" ref="whatsapp_template_sales_order"/>
            <field name="sequence">1</field>
            <field name="field_expression">partner_id.name</field>
            <field name="default_value">Valued Customer</field>
        </record>
        <record id="var_so_number" model="whatsapp.template.variable">
            <field name="template_id" ref="whatsapp_template_sales_order"/>
            <field name="sequence">2</field>
            <field name="field_expression">name</field>
            <field name="default_value">Order</field>
        </record>
        <record id="var_so_amount" model="whatsapp.template.variable">
            <field name="template_id" ref="whatsapp_template_sales_order"/>
            <field name="sequence">3</field>
            <field name="field_expression">amount_total</field>
            <field name="default_value">0.00</field>
        </record>

        <!-- Default Template 2: Customer Invoice Notification -->
        <record id="whatsapp_template_customer_invoice" model="whatsapp.template">
            <field name="name">Customer Invoice Notification</field>
            <field name="template_name">customer_invoice_notification</field>
            <field name="language_code">en_US</field>
            <field name="category">UTILITY</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="header_type">document</field>
            <field name="report_id" ref="account.account_invoices"/>
            <field name="body_text">Hello {{1}}, Invoice {{2}} for {{3}} has been generated. Please find your invoice PDF attached for payment details. Due Date: {{4}}. Thank you!</field>
        </record>

        <record id="var_inv_customer" model="whatsapp.template.variable">
            <field name="template_id" ref="whatsapp_template_customer_invoice"/>
            <field name="sequence">1</field>
            <field name="field_expression">partner_id.name</field>
            <field name="default_value">Valued Customer</field>
        </record>
        <record id="var_inv_number" model="whatsapp.template.variable">
            <field name="template_id" ref="whatsapp_template_customer_invoice"/>
            <field name="sequence">2</field>
            <field name="field_expression">name</field>
            <field name="default_value">Invoice</field>
        </record>
        <record id="var_inv_amount" model="whatsapp.template.variable">
            <field name="template_id" ref="whatsapp_template_customer_invoice"/>
            <field name="sequence">3</field>
            <field name="field_expression">amount_total</field>
            <field name="default_value">0.00</field>
        </record>
        <record id="var_inv_due" model="whatsapp.template.variable">
            <field name="template_id" ref="whatsapp_template_customer_invoice"/>
            <field name="sequence">4</field>
            <field name="field_expression">invoice_date_due</field>
            <field name="default_value">Upon Receipt</field>
        </record>

        <!-- Default Template 3: Delivery Dispatch Notification -->
        <record id="whatsapp_template_delivery_order" model="whatsapp.template">
            <field name="name">Delivery Dispatch Notification</field>
            <field name="template_name">order_dispatch_alert</field>
            <field name="language_code">en_US</field>
            <field name="category">UTILITY</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="header_type">document</field>
            <field name="report_id" ref="stock.action_report_delivery"/>
            <field name="body_text">Hello {{1}}, your delivery {{2}} is on its way! Please find the attached delivery slip for full item details.</field>
        </record>

        <record id="var_del_customer" model="whatsapp.template.variable">
            <field name="template_id" ref="whatsapp_template_delivery_order"/>
            <field name="sequence">1</field>
            <field name="field_expression">partner_id.name</field>
            <field name="default_value">Valued Customer</field>
        </record>
        <record id="var_del_number" model="whatsapp.template.variable">
            <field name="template_id" ref="whatsapp_template_delivery_order"/>
            <field name="sequence">2</field>
            <field name="field_expression">name</field>
            <field name="default_value">Delivery Order</field>
        </record>

        <!-- Set Default Configuration Parameters -->
        <record id="param_auto_sale" model="ir.config_parameter">
            <field name="key">whatsapp_all_in_one_engine.auto_sale</field>
            <field name="value">True</field>
        </record>
        <record id="param_sale_template" model="ir.config_parameter">
            <field name="key">whatsapp_all_in_one_engine.sale_template_id</field>
            <field name="value" eval="ref('whatsapp_template_sales_order')"/>
        </record>
        <record id="param_auto_invoice" model="ir.config_parameter">
            <field name="key">whatsapp_all_in_one_engine.auto_invoice</field>
            <field name="value">True</field>
        </record>
        <record id="param_invoice_template" model="ir.config_parameter">
            <field name="key">whatsapp_all_in_one_engine.invoice_template_id</field>
            <field name="value" eval="ref('whatsapp_template_customer_invoice')"/>
        </record>
        <record id="param_auto_delivery" model="ir.config_parameter">
            <field name="key">whatsapp_all_in_one_engine.auto_delivery</field>
            <field name="value">True</field>
        </record>
        <record id="param_delivery_template" model="ir.config_parameter">
            <field name="key">whatsapp_all_in_one_engine.delivery_template_id</field>
            <field name="value" eval="ref('whatsapp_template_delivery_order')"/>
        </record>
    </data>
</odoo>
