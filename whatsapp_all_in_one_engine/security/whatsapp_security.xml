<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Groups -->
    <record id="group_whatsapp_user" model="res.groups">
        <field name="name">WhatsApp User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_whatsapp_manager" model="res.groups">
        <field name="name">WhatsApp Administrator</field>
        <field name="implied_ids" eval="[(4, ref('group_whatsapp_user'))]"/>
    </record>

    <!-- Multi-company Record Rules -->
    <record id="whatsapp_message_log_comp_rule" model="ir.rule">
        <field name="name">WhatsApp Message Log Multi-Company</field>
        <field name="model_id" ref="model_whatsapp_message_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="whatsapp_template_comp_rule" model="ir.rule">
        <field name="name">WhatsApp Template Multi-Company</field>
        <field name="model_id" ref="model_whatsapp_template"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
