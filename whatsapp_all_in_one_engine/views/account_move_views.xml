<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_whatsapp" model="ir.ui.view">
        <field name="name">account.move.form.inherit.whatsapp</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add WhatsApp Button in Header -->
            <xpath expr="//header" position="inside">
                <button name="action_send_whatsapp"
                        string="Send WhatsApp"
                        type="object"
                        class="btn-outline-success"
                        icon="fa-whatsapp"
                        invisible="move_type not in ('out_invoice', 'out_refund')"
                        title="Send Customer Invoice PDF and payment details via WhatsApp"/>
            </xpath>

            <!-- Add WhatsApp Status Badge in Sheet -->
            <xpath expr="//div[@name='due_date']" position="after">
                <field name="whatsapp_status" widget="badge"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       decoration-success="whatsapp_status == 'sent'"
                       decoration-danger="whatsapp_status == 'failed'"
                       decoration-muted="whatsapp_status == 'not_sent'"/>
            </xpath>
        </field>
    </record>
</odoo>
