<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_whatsapp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="95"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="WhatsApp Engine" string="WhatsApp Engine" name="whatsapp_all_in_one_engine">
                    <block title="Official Meta WhatsApp Cloud API Configuration" name="meta_whatsapp_config">
                        <div class="row mt16 o_settings_container">
                            <setting id="meta_credentials" string="Meta Cloud API Credentials" help="Set your Meta for Developers credentials for direct official messaging.">
                                <div class="content-group">
                                    <div class="row mt8">
                                        <label for="whatsapp_api_url" class="col-lg-4 o_light_label"/>
                                        <field name="whatsapp_api_url"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="whatsapp_api_version" class="col-lg-4 o_light_label"/>
                                        <field name="whatsapp_api_version"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="whatsapp_phone_number_id" class="col-lg-4 o_light_label"/>
                                        <field name="whatsapp_phone_number_id" placeholder="e.g. 109876543210987"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="whatsapp_business_account_id" class="col-lg-4 o_light_label"/>
                                        <field name="whatsapp_business_account_id" placeholder="e.g. 109876543210111"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="whatsapp_access_token" class="col-lg-4 o_light_label"/>
                                        <field name="whatsapp_access_token" password="True" placeholder="Permanent System User Token"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="whatsapp_webhook_token" class="col-lg-4 o_light_label"/>
                                        <field name="whatsapp_webhook_token" password="True"/>
                                    </div>
                                    <div class="mt16">
                                        <button name="action_test_whatsapp_connection" type="object" string="Test Meta API Connection" class="btn btn-outline-success" icon="fa-plug"/>
                                    </div>
                                </div>
                            </setting>
                        </div>
                    </block>

                    <block title="Automated WhatsApp Workflows (Auto-Dispatches)" name="whatsapp_workflows">
                        <div class="row mt16 o_settings_container">
                            <setting id="auto_sale_order" string="Sales Order Confirmation" help="Automatically send WhatsApp confirmation message + PDF when Sales Order is confirmed.">
                                <field name="whatsapp_auto_sale"/>
                                <div class="content-group" invisible="not whatsapp_auto_sale">
                                    <div class="row mt8">
                                        <label for="whatsapp_sale_template_id" class="col-lg-4 o_light_label"/>
                                        <field name="whatsapp_sale_template_id" options="{'no_create': True}"/>
                                    </div>
                                </div>
                            </setting>

                            <setting id="auto_invoice" string="Customer Invoice Notification" help="Automatically send WhatsApp notification + Invoice PDF when invoice is posted.">
                                <field name="whatsapp_auto_invoice"/>
                                <div class="content-group" invisible="not whatsapp_auto_invoice">
                                    <div class="row mt8">
                                        <label for="whatsapp_invoice_template_id" class="col-lg-4 o_light_label"/>
                                        <field name="whatsapp_invoice_template_id" options="{'no_create': True}"/>
                                    </div>
                                </div>
                            </setting>

                            <setting id="auto_delivery" string="Order Delivery / Dispatch Alert" help="Automatically send WhatsApp alert + Delivery Slip PDF when warehouse dispatch is validated.">
                                <field name="whatsapp_auto_delivery"/>
                                <div class="content-group" invisible="not whatsapp_auto_delivery">
                                    <div class="row mt8">
                                        <label for="whatsapp_delivery_template_id" class="col-lg-4 o_light_label"/>
                                        <field name="whatsapp_delivery_template_id" options="{'no_create': True}"/>
                                    </div>
                                </div>
                            </setting>
                        </div>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_whatsapp_config_settings" model="ir.actions.act_window">
        <field name="name">WhatsApp Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'whatsapp_all_in_one_engine', 'bin_size': False}</field>
    </record>
</odoo>
