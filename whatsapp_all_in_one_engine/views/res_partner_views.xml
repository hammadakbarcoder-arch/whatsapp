<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_whatsapp" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.whatsapp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Header WhatsApp Actions -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_send_whatsapp"
                            string="Send WhatsApp"
                            type="object"
                            class="btn-outline-success"
                            icon="fa-whatsapp"
                            title="Send WhatsApp message directly to this contact"/>
                    <button name="action_log_whatsapp_call"
                            string="Log WhatsApp Call"
                            type="object"
                            class="btn-outline-primary"
                            icon="fa-phone"
                            title="Log a voice or video call on the customer timeline"/>
                </header>
            </xpath>

            <!-- Stat Buttons in Button Box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_whatsapp_logs"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-whatsapp"
                        invisible="whatsapp_message_count == 0">
                    <field name="whatsapp_message_count" widget="statinfo" string="WhatsApp"/>
                </button>
                <button name="action_view_whatsapp_calls"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-phone"
                        invisible="whatsapp_call_count == 0">
                    <field name="whatsapp_call_count" widget="statinfo" string="WA Calls"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
