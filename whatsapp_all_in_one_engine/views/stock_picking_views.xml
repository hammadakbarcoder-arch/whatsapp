<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_whatsapp" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.whatsapp</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Add WhatsApp Button in Header -->
            <xpath expr="//header" position="inside">
                <button name="action_send_whatsapp"
                        string="Send WhatsApp"
                        type="object"
                        class="btn-outline-success"
                        icon="fa-whatsapp"
                        invisible="picking_type_code != 'outgoing'"
                        title="Send Delivery Slip PDF and dispatch alert via WhatsApp"/>
            </xpath>

            <!-- Add WhatsApp Status Badge in Sheet -->
            <xpath expr="//field[@name='origin']" position="after">
                <field name="whatsapp_status" widget="badge"
                       invisible="picking_type_code != 'outgoing'"
                       decoration-success="whatsapp_status == 'sent'"
                       decoration-danger="whatsapp_status == 'failed'"
                       decoration-muted="whatsapp_status == 'not_sent'"/>
            </xpath>
        </field>
    </record>
</odoo>
