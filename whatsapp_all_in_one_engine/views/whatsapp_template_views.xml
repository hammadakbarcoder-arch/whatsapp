<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template List View -->
    <record id="view_whatsapp_template_list" model="ir.ui.view">
        <field name="name">whatsapp.template.list</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <tree string="WhatsApp Templates">
                <field name="name"/>
                <field name="template_name"/>
                <field name="model_id"/>
                <field name="header_type"/>
                <field name="language_code"/>
                <field name="category"/>
                <field name="report_id" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Template Form View -->
    <record id="view_whatsapp_template_form" model="ir.ui.view">
        <field name="name">whatsapp.template.form</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Meta Template">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Sales Order Confirmation"/></h1>
                    </div>
                    <group>
                        <group string="Meta API Configuration">
                            <field name="template_name" placeholder="e.g. sales_order_confirm"/>
                            <field name="language_code" placeholder="e.g. en_US"/>
                            <field name="category"/>
                            <field name="model_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Attachment &amp; Header">
                            <field name="header_type"/>
                            <field name="header_text" invisible="header_type != 'text'"/>
                            <field name="report_id" invisible="header_type != 'document'" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Message Body (Meta Template)" name="body">
                            <div class="alert alert-info" role="alert">
                                <strong>Tip:</strong> Use standard Meta placeholders like <code>{{1}}</code>, <code>{{2}}</code>, <code>{{3}}</code>. Configure the matching dynamic variables below.
                            </div>
                            <field name="body_text" widget="text" placeholder="Hello {{1}}, your order {{2}} has been confirmed..."/>
                        </page>
                        <page string="Dynamic Variables Mapping" name="variables">
                            <field name="variable_ids">
                                <tree editable="bottom">
                                    <field name="sequence"/>
                                    <field name="field_expression" placeholder="e.g. partner_id.name or amount_total"/>
                                    <field name="default_value" placeholder="Fallback text if empty"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Template Search View -->
    <record id="view_whatsapp_template_search" model="ir.ui.view">
        <field name="name">whatsapp.template.search</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <search string="Search Templates">
                <field name="name"/>
                <field name="template_name"/>
                <field name="model_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="With PDF Report" name="has_report" domain="[('header_type', '=', 'document')]"/>
                <group>
                    <filter string="Model" name="group_by_model" domain="[]" context="{'group_by': 'model_id'}"/>
                    <filter string="Category" name="group_by_category" domain="[]" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_whatsapp_template" model="ir.actions.act_window">
        <field name="name">WhatsApp Templates</field>
        <field name="res_model">whatsapp.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Meta WhatsApp Template!
            </p>
            <p>
                Map pre-approved Meta WhatsApp templates with Odoo records and dynamic fields for instant automated dispatch.
            </p>
        </field>
    </record>
</odoo>
